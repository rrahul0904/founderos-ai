# Zero-config development mode. Production should use shared-key or replace the auth adapter.
AUTH_MODE=dev
ALLOW_DEV_AUTH=false
FOUNDEROS_API_KEY=
FOUNDEROS_ORG_ID=00000000-0000-4000-8000-000000000001

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Set these to enforce real cost accounting for your selected OpenAI model.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0

# Optional search provider for research.search jobs.
TAVILY_API_KEY=

# Phase 2 GitHub delivery. Keep the token server-side and prefer a fine-grained token
# limited to the repositories FounderOS is allowed to manage.
GITHUB_TOKEN=
FOUNDEROS_GITHUB_ALLOWED_REPOS=
# Development escape hatch only. Production should prefer explicit allowlists.
FOUNDEROS_GITHUB_ALLOW_ANY_REPO=false

# Leave blank for in-memory development. Uncomment for PostgreSQL.
DATABASE_URL=
# DATABASE_URL=postgres://founderos:founderos@localhost:5432/founderos
NEXT_PUBLIC_APP_NAME=FounderOS
